# Copia este archivo a ".env" (si no esta el archivo crearlo como ".env") y ajusta los valores antes de levantar los contenedores.
# El archivo ".env" NO se debe commitear (ya esta en .gitignore).

DB_NAME=mercado_db
DB_USER=mercado_user
DB_PASSWORD=admin
DB_ROOT_PASSWORD=root
DB_PORT=3306

BACKEND_PORT=8080

# Carpeta de Windows donde se van a guardar los backups automaticos (puede ser de otro disco,
# ej. "D:/Backups/MercadoApp"). Si no se define, usa "./backend_backups" al lado de este archivo.
# Cambiar este valor requiere reiniciar los contenedores ("docker compose up -d") para que aplique.
BACKUP_HOST_PATH=./backend_backups
